# /opt/unicornt/prod/.env  — copy to `.env` on the server and fill in.
# Never commit the real file. Consumed by deploy/prod/docker-compose.yml.

DOCKERHUB_USERNAME=__CHANGE_ME__
IMAGE_TAG=latest

# --- Datasource: Supabase (no db container in prod) --------------------------
# Session pooler host, port 5432. Add &sslmode=require if the driver needs it.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres?currentSchema=unicornt_store
SPRING_DATASOURCE_USERNAME=__CHANGE_ME__
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME__

# --- Application ---------------------------------------------------------------
# ddl-auto=validate and no docs come from the "prod" profile. There is no
# JPA_DDL_AUTO override — application-prod.yml hardcodes validate.
APP_JWT_SECRET=__CHANGE_ME_BASE64_MIN_32_BYTES__
APP_JWT_EXPIRATION_MS=3600000
APP_CORS_ALLOWED_ORIGINS=https://unicornt-store.keber.cl

# Schema: prod does NOT mutate its schema on boot. Run V1..V3 by hand against
# Supabase once, then leave this at `never` — boot-time schema initialization
# against a pooled managed database is the wrong default, and ddl-auto=validate
# will fail fast and loudly if the schema is not what the entities expect.
# dev/qa keep `always`: their Postgres containers are disposable.
SQL_INIT_MODE=never
FLYWAY_ENABLED=false

# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=

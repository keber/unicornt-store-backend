# /opt/unicornt/dev/.env  — copy to `.env` on the server and fill in.
# Never commit the real file. Consumed by deploy/dev/docker-compose.yml.

# Docker Hub repo owner (used to build the image reference).
DOCKERHUB_USERNAME=__CHANGE_ME__
# Set/overwritten by deploy.sh on every deploy; seed it for the first bring-up.
IMAGE_TAG=latest

# --- Postgres container (service "db") -------------------------------------
POSTGRES_DB=unicornt_dev
POSTGRES_USER=unicornt_dev
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Application ---------------------------------------------------------------
# ddl-auto and Swagger come from the "dev" profile; no need to set them here.
APP_JWT_SECRET=__CHANGE_ME_BASE64_MIN_32_BYTES__
APP_JWT_EXPIRATION_MS=3600000
APP_CORS_ALLOWED_ORIGINS=https://unicornt-dev.keber.dev

# Schema bootstrap (Spring SQL init until Flyway is on the classpath).
SQL_INIT_MODE=always
FLYWAY_ENABLED=false

# One-time admin bootstrap (optional; clear again once the account exists).
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=

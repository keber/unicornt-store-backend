# /opt/unicornt/qa/.env  — copy to `.env` on the server and fill in.
# Never commit the real file. Consumed by deploy/qa/docker-compose.yml.

DOCKERHUB_USERNAME=__CHANGE_ME__
IMAGE_TAG=latest

# --- Postgres container (service "db") -------------------------------------
POSTGRES_DB=unicornt_qa
POSTGRES_USER=unicornt_qa
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Application ---------------------------------------------------------------
# ddl-auto=validate and Swagger-on come from the "qa" profile.
APP_JWT_SECRET=__CHANGE_ME_BASE64_MIN_32_BYTES__
APP_JWT_EXPIRATION_MS=3600000
APP_CORS_ALLOWED_ORIGINS=https://unicornt-qa.keber.cl

SQL_INIT_MODE=always
FLYWAY_ENABLED=false

# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=

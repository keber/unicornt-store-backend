# Normalize all text files to LF in the repository. Git auto-detects text vs
# binary; `eol=lf` makes the checkout LF for everyone regardless of each
# developer's core.autocrlf setting.
* text=auto eol=lf

# --- Explicit text types (clarity + safety) ---
*.java        text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.html        text eol=lf
*.svg         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.sql         text eol=lf
*.properties  text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.sh          text eol=lf
*.gitignore   text eol=lf
*.gitkeep     text eol=lf
*.gitlint     text eol=lf

# --- Windows-only scripts keep CRLF ---
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# --- Binary: never touch ---
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.jar         binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary

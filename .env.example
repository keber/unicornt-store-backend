# Copy to .env and replace every __CHANGE_ME__ placeholder.
# The real .env is ignored by git; never commit credentials.

SERVER_PORT=8080
# dev = schema kept in sync and Swagger UI exposed; prod = validate only, no docs.
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# PostgreSQL container (docker compose): consumed by the "db" service and by the
# "app" service, which builds its JDBC URL as jdbc:postgresql://db:5432/${POSTGRES_DB}
# ---------------------------------------------------------------------------
POSTGRES_DB=unicornt_db
POSTGRES_USER=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__

# ---------------------------------------------------------------------------
# Datasource used when the application runs outside compose (./mvnw spring-boot:run)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unicornt_db
SPRING_DATASOURCE_USERNAME=__CHANGE_ME__
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME__

# ---------------------------------------------------------------------------
# Schema management
# ---------------------------------------------------------------------------
# Hibernate schema strategy. The base profile defaults to "validate"; dev overrides
# it with "update". Only set this if you need to override the active profile.
JPA_DDL_AUTO=validate
# The versioned scripts in src/main/resources/db/migration are applied on startup by
# Spring's SQL initializer (SQL_INIT_MODE=always). Flyway takes over once the module
# org.springframework.boot:spring-boot-flyway is on the classpath: then set
# FLYWAY_ENABLED=true and SQL_INIT_MODE=never.
FLYWAY_ENABLED=false
SQL_INIT_MODE=always

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# JWT signing key, base64 encoded, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
APP_JWT_SECRET=__CHANGE_ME_BASE64_MIN_32_BYTES__
APP_JWT_EXPIRATION_MS=3600000

# Allowed browser origins for CORS, comma separated.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

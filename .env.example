# Copy to .env and replace every __CHANGE_ME__ placeholder.
# The real .env is ignored by git; never commit credentials.

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL container (docker compose)
POSTGRES_DB=unicornt_db
POSTGRES_USER=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__

# Datasource used by the application
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unicornt_db
SPRING_DATASOURCE_USERNAME=__CHANGE_ME__
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME__

# JWT signing key, base64 encoded, at least 32 bytes
APP_JWT_SECRET=__CHANGE_ME_BASE64_MIN_32_BYTES__
APP_JWT_EXPIRATION_MS=3600000

# Allowed browser origins for CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "shippingAddress": {
      "street": "Av. Providencia 1234",
      "city": "Santiago",
      "region": "Region Metropolitana",
      "zipCode": "7500000"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

tests {
  test("the order is confirmed", function () {
    expect(res.getBody().status).to.equal("CONFIRMED");
  });
}

script:post-response {
  // Get Order used to ask for /orders/1, which belongs to whoever registered
  // first on that environment. The id of the order this run just placed is the
  // only one it is entitled to read.
  if (res.body && res.body.id) {
    bru.setEnvVar("orderId", res.body.id);
  }
}

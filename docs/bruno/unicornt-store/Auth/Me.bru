meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the token identifies the account that just registered", function () {
    expect(res.getBody().email).to.equal(bru.getEnvVar("email"));
  });
}

meta {
  name: Get Cart
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/cart
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the server cart survives the round trip", function () {
    expect(res.getBody().itemCount).to.be.at.least(1);
    expect(res.getBody().total).to.be.a("number").and.to.be.above(0);
  });
}
